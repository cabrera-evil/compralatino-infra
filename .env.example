# Shared PostgreSQL instance (schema-per-service, see init-db/001-init-schemas.sql)
POSTGRES_USER=compralatino
POSTGRES_PASSWORD=compralatino
POSTGRES_DB=compralatino
POSTGRES_PORT=5432

# Shared Redis (cache + queues)
REDIS_PASSWORD=compralatino
REDIS_PORT=6379

# Shared RabbitMQ (inter-service pub/sub)
RABBITMQ_USER=compralatino
RABBITMQ_PASSWORD=compralatino
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Traefik gateway (dev stand-in for the Kubernetes ingress)
GATEWAY_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
