# Shared PostgreSQL instance (schema-per-service, see init-db/001-init-schemas.sql)
POSTGRES_USER=compralatino
POSTGRES_PASSWORD=compralatino
POSTGRES_DB=compralatino
POSTGRES_PORT=5432

# Shared Redis (cache + queues)
REDIS_PASSWORD=compralatino
REDIS_PORT=6379

# Shared RabbitMQ (inter-service pub/sub)
RABBITMQ_USER=compralatino
RABBITMQ_PASSWORD=compralatino
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Traefik gateway (dev stand-in for the Kubernetes ingress)
GATEWAY_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# RabbitMQ request/reply timeouts (ms): orders->catalog, catalog->yauctions, recommendations->catalog
CATALOG_RPC_TIMEOUT_MS=5000
YAUCTIONS_RPC_TIMEOUT_MS=3000

# yauctions-api in-process catalog sync (off by default; see compralatino-yauctions-api/docs/yauctions-sync.md)
SCRAPER_ENABLED=false
SCRAPER_INTERVAL_MS=21600000

# Frontend origin injected as NEXT_PUBLIC_HOST (same-origin proxy, no CORS)
FRONTEND_ORIGIN=http://localhost

# Docker image tag to use for all services (see docker-compose.override.yml)
IMAGE_TAG=latest
